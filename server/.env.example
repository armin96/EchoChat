# EchoChat Server Environment Variables

# Server Port
PORT=3000

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Connection String (Atlas or Local)
# Leave commented out or empty to use automatic In-Memory zero-config database
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/echochat?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/echochat
